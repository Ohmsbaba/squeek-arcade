DATABASE_URL=postgresql://localhost:5432/squeek_arcade
# 32+ random characters. Signs session cookies.
SESSION_SECRET=
# Turns on /admin. Leave empty to keep it closed.
ADMIN_PASSWORD=
# The public address, used in the wallet sign-in message and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# Optional: enables WalletConnect for phones without a wallet browser.
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional: comma-separated Sepolia RPCs tried in order, before the public ones.
SEPOLIA_RPC_URLS=
# Development only, ignored in production: "<address>:<address>" treats the first wallet as holding
# the second wallet's Squeeks, so the NFT flow can be exercised without its keys.
DEV_NFT_ALIAS=
# Optional: new guests per address per hour (default 20). Raise it when testing locally.
GUEST_LIMIT_PER_HOUR=
